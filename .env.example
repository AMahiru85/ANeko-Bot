# QQ official bot credentials from https://q.qq.com/
QQ_APP_ID=
QQ_APP_SECRET=

# Official QQ Bot endpoints
QQ_AUTH_BASE=https://bots.qq.com
QQ_API_BASE=https://api.sgroup.qq.com
QQ_GATEWAY_URL=
# C2C + group-at + direct + interactions. The QQ console must grant matching intents.
QQ_INTENTS=100667392

# Default provider. Every provider with an API key appears in /settings.
AI_PROVIDER=deepseek

# DeepSeek OpenAI-compatible API. Set DEEPSEEK_API_STYLE=messages to use the
# Anthropic-compatible Messages transport used by deepseek-harness.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_STYLE=chat
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# Additional OpenAI-compatible providers. A provider is enabled when its key is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini,gpt-4o

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_MODELS=moonshot-v1-8k,moonshot-v1-32k

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MODELS=qwen-plus,qwen-max

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3,deepseek-ai/DeepSeek-R1

# Optional provider array. Each item can use literal values or *Env names.
# Example: [{"id":"glm","name":"智谱","apiKeyEnv":"GLM_API_KEY","baseUrlEnv":"GLM_BASE_URL","defaultModelEnv":"GLM_MODEL","capabilities":{"vision":true}}]
CUSTOM_PROVIDERS_JSON=[]

# Backward-compatible single custom provider aliases.
OTHER_AI_BASE_URL=
OTHER_AI_API_KEY=
OTHER_AI_MODEL=

LLM_REASONING_EFFORT=none
SYSTEM_PROMPT=
HTTP_PORT=3000
STREAM_UPDATE_INTERVAL_MS=800
MAX_CONTEXT_MESSAGES=20
WEB_SEARCH_ENABLED=true
WEB_FETCH_TIMEOUT_MS=12000
