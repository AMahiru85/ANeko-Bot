# QQ official bot credentials from https://q.qq.com/
QQ_APP_ID=
QQ_CLIENT_SECRET=

# Official QQ Bot API endpoints
QQ_API_BASE=https://api.bot.qq.com
QQ_GATEWAY_URL=

# Gateway Identify bitmask for C2C private messages; button interaction is added automatically.
QQ_INTENTS=33554432

# AI provider: deepseek uses the official API defaults; other keeps an
# OpenAI-compatible endpoint configured below.
AI_PROVIDER=deepseek

# DeepSeek (https://api.deepseek.com). DEEPSEEK_BASE_URL is optional and is
# only needed when routing through a compatible gateway.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash

# Other OpenAI-compatible providers. These are ignored when AI_PROVIDER=deepseek.
OTHER_AI_BASE_URL=
OTHER_AI_API_KEY=
OTHER_AI_MODEL=
LLM_REASONING_EFFORT=none

# Agent behavior
SYSTEM_PROMPT=
HTTP_PORT=3000
