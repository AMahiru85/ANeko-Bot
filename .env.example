# QQ official bot credentials from https://q.qq.com/
QQ_APP_ID=
QQ_CLIENT_SECRET=

# Official QQ Bot API endpoints
QQ_API_BASE=https://api.bot.qq.com
QQ_GATEWAY_URL=

# Gateway Identify bitmask for C2C private messages. Usually leave this unchanged.
QQ_INTENTS=33554432

# OpenAI-compatible LLM API. The defaults use DeepSeek as an example.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Agent behavior
SYSTEM_PROMPT=
HTTP_PORT=3000
