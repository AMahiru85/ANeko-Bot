[Unit]
Description=QQ LLM private chat agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqbot
WorkingDirectory=/opt/qq-llm-agent
EnvironmentFile=/opt/qq-llm-agent/.env
ExecStart=/usr/bin/node /opt/qq-llm-agent/src/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
